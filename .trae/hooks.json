{
  "version": 1,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$TRAE_PROJECT_DIR/.trae/hooks/ask_gate.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$TRAE_PROJECT_DIR/.trae/hooks/pretooluse_logger.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
